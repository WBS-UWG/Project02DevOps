<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <title>Comp 4420 - Add an element</title>
  <meta name="description" content="Add a movie or a series">
  <meta name="author" content="William Sitt - Comp 4420">
  <!-- Bootstrap CSS -->
  <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.2.1/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

<div class="container mt-5" style="max-width: 600px;">

  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Add an element</h1>
    <a href="/" class="btn btn-outline-secondary btn-sm">Back</a>
  </div>

  <div class="card shadow-sm border">
    <div class="card-body p-4">
      <form action="/items" method="POST">
        
        <div class="form-group">
          <label for="title" class="font-weight-bold">Title</label>
          <input type="text" class="form-control" id="title" name="title" required placeholder="Ex: Inception, Breaking Bad...">
        </div>

        <div class="form-group">
          <label for="type" class="font-weight-bold">Type</label>
          <select class="form-control" id="type" name="type" required>
            <option value="1">Film</option>
            <option value="2">Série</option>
          </select>
        </div>

        <div class="form-group">
          <label for="rate" class="font-weight-bold">Rate (on 5)</label>
          <select class="form-control" id="rate" name="rate" required>
            <option value="5">★★★★★ (5/5)</option>
            <option value="4">★★★★☆ (4/5)</option>
            <option value="3">★★★☆☆ (3/5)</option>
            <option value="2">★★☆☆☆ (2/5)</option>
            <option value="1">★☆☆☆☆ (1/5)</option>
          </select>
        </div>

        <div class="form-group">
          <label for="description" class="font-weight-bold">Description</label>
          <textarea class="form-control" id="description" name="description" rows="3" placeholder="Quick summary or review..."></textarea>
        </div>

        <div class="d-flex justify-content-end mt-4">
          <a href="/" class="btn btn-light mr-2">Cancel</a>
          <button type="submit" class="btn btn-primary">Save</button>
        </div>

      </form>
    </div>
  </div>

</div>

</body>
</html>