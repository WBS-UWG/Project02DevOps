<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <title>Comp 4420 Film Tracker</title>
  <meta name="description" content="Convert Java app to web app">
  <meta name="author" content="William Sitt - Comp 4420">
  <!-- Bootstrap CSS -->
  <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.2.1/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

<div class="container mt-5">

  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
      <h1 class="mb-1">Film Tracker</h1>
      <p class="text-muted mb-0">
        <%= items.length %> elements to see
      </p>
    </div>
    <div class="mt-3 mt-md-0">
      <a href="/watchlist" class="btn btn-outline-secondary mr-2">Watchlist</a>
      <a href="/addItem" class="btn btn-primary">+ Add an item</a>
    </div>
  </div>

  <ul class="nav nav-pills mb-3">
    <li class="nav-item">
      <a class="nav-link <%= filter === 'all' ? 'active' : '' %>" href="/">
        Tous <span class="badge badge-light"><%= counts.all %></span>
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link <%= filter === 'film' ? 'active' : '' %>" href="/?type=film">
        Films <span class="badge badge-light"><%= counts.film %></span>
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link <%= filter === 'serie' ? 'active' : '' %>" href="/?type=serie">
        Séries <span class="badge badge-light"><%= counts.serie %></span>
      </a>
    </li>
  </ul>

  <% if (items.length === 0) { %>
    <div class="alert alert-light border text-center">
      No items in this category yet.
    </div>
  <% } else { %>
    <div class="table-responsive">
      <table class="table table-hover bg-white border">
        <thead class="thead-light">
          <tr>
            <th scope="col">Titre</th>
            <th scope="col">Note</th>
            <th scope="col">Description</th>
            <th scope="col">Type</th>
          </tr>
        </thead>
        <tbody>
          <% items.forEach(function (item) { %>
            <% const rating = Math.max(0, Math.min(5, Number(item.rating) || 0)); %>
            <tr>
              <td class="font-weight-bold"><%= item.titre %></td>
              <td class="text-nowrap" aria-label="Note <%= rating %> sur 5">
                <span aria-hidden="true">
                  <span class="text-warning"><%= '★'.repeat(rating) %></span><span class="text-muted"><%= '☆'.repeat(5 - rating) %></span>
                </span>
                <small class="text-muted ml-1"><%= rating %>/5</small>
              </td>
              <td><%= item.description %></td>
              <td>
                <% if (item.type === 'film') { %>
                  <span class="badge badge-primary">Film</span>
                <% } else { %>
                  <span class="badge badge-warning">Série</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>

</div>
</body>
</html>