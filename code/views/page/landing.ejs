<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <title>Comp 4420 Film Tracker</title>
  <meta name="description" content="Convert Java app to web app">
  <meta name="author" content="William Sitt - Comp 4420">
  <!-- Bootstrap CSS -->
  <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.2.1/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

<div class="container mt-5">

  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
      <h1 class="mb-1">Film Tracker</h1>
      <p class="text-muted mb-0">
        <%= items.length %> elements to see
      </p>
    </div>
    <div class="mt-3 mt-md-0">
      <a href="/watchlist" class="btn btn-outline-secondary mr-2">Watchlist</a>
      <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#addModal">+ Add an item</button>
    </div>
  </div>

  <ul class="nav nav-pills mb-3">
    <li class="nav-item">
      <a class="nav-link <%= filter === 'all' ? 'active' : '' %>" href="/">
        Tous <span class="badge badge-light"><%= counts.all %></span>
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link <%= filter === 'film' ? 'active' : '' %>" href="/?type=film">
        Films <span class="badge badge-light"><%= counts.film %></span>
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link <%= filter === 'serie' ? 'active' : '' %>" href="/?type=serie">
        Séries <span class="badge badge-light"><%= counts.serie %></span>
      </a>
    </li>
  </ul>

  <% if (items.length === 0) { %>
    <div class="alert alert-light border text-center">
      No items in this category yet.
    </div>
  <% } else { %>
    <div class="table-responsive">
      <table class="table table-hover bg-white border">
        <thead class="thead-light">
          <tr>
            <th scope="col">Titre</th>
            <th scope="col">Note</th>
            <th scope="col">Description</th>
            <th scope="col">Type</th>
            <th scope="col">Progression</th>
          </tr>
        </thead>
        <tbody>
          <% items.forEach(function (item) { %>
            <% const rating = Math.max(0, Math.min(5, Number(item.rating) || 0)); %>
            <tr>
              <td class="font-weight-bold"><%= item.titre %></td>
              <td class="text-nowrap" aria-label="Note <%= rating %> sur 5">
                <span aria-hidden="true">
                  <span class="text-warning"><%= '★'.repeat(rating) %></span><span class="text-muted"><%= '☆'.repeat(5 - rating) %></span>
                </span>
                <small class="text-muted ml-1"><%= rating %>/5</small>
              </td>
              <td><%= item.description %></td>
              <td>
                <% if (item.type === 'film') { %>
                  <span class="badge badge-primary">Film</span>
                <% } else { %>
                  <span class="badge badge-warning">Series</span>
                <% } %>
              </td>
              <td>
                <% if (item.type === 'serie' && item.season) { %>
                  Season <%= item.season %><% if (item.episode) { %>, episode <%= item.episode %><% } %>
                <% } else if (item.type === 'serie') { %>
                  Not specify
                <% } else { %>
                  —
                <% } %>
                <% if (item.type === 'serie') { %>
                  <button type="button" class="btn btn-sm btn-link p-0 ml-2"
                          data-toggle="modal" data-target="#progressModal"
                          data-id="<%= item.id %>"
                          data-season="<%= item.season == null ? '' : item.season %>"
                          data-episode="<%= item.episode == null ? '' : item.episode %>">
                    Edit progress
                  </button>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>

</div>

<div class="modal fade" id="addModal" tabindex="-1" role="dialog" aria-labelledby="addModalLabel" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <form action="/addItem" method="POST">
        <div class="modal-header">
          <h5 class="modal-title" id="addModalLabel">Add an item</h5>
          <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="modal-body">
          <div class="form-group">
            <label for="add-title">Title</label>
            <input type="text" class="form-control" id="add-title" name="title" required>
          </div>
          <div class="form-group">
            <label for="add-type">Type</label>
            <select class="form-control" id="add-type" name="type" required>
              <option value="1">Film</option>
              <option value="2">Series</option>
            </select>
          </div>
          <div class="form-group">
            <label for="add-rate">Note (1 to 5)</label>
            <input type="number" class="form-control" id="add-rate" name="rate" min="1" max="5" value="3">
          </div>
          <div class="series-add-progress d-none">
            <div class="form-group">
              <label for="add-season">Last watched season</label>
              <input type="number" class="form-control" id="add-season" name="season" min="1" step="1">
            </div>
            <div class="form-group">
              <label for="add-episode">Last watched episode (optional)</label>
              <input type="number" class="form-control" id="add-episode" name="episode" min="1" step="1">
            </div>
          </div>
          <div class="form-group">
            <label for="add-description">Description</label>
            <textarea class="form-control" id="add-description" name="description" rows="3"></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Add</button>
        </div>
      </form>
    </div>
  </div>
</div>

<div class="modal fade" id="progressModal" tabindex="-1" role="dialog" aria-labelledby="progressModalLabel" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <form action="/items/progress" method="POST">
        <div class="modal-header">
          <h5 class="modal-title" id="progressModalLabel">Edit progress</h5>
          <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="modal-body">
          <input type="hidden" id="progress-id" name="id">
          <div class="form-group">
            <label for="progress-season">Last watched season</label>
            <input type="number" class="form-control" id="progress-season" name="season" min="1" step="1">
          </div>
          <div class="form-group">
            <label for="progress-episode">Last watched episode (optional)</label>
            <input type="number" class="form-control" id="progress-episode" name="episode" min="1" step="1">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Save</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.6/umd/popper.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.2.1/js/bootstrap.min.js"></script>
<script>
  function toggleAddProgress() {
    $('.series-add-progress').toggleClass('d-none', $('#add-type').val() !== '2');
  }

  $('#add-type').on('change', toggleAddProgress);

  $('#progressModal').on('show.bs.modal', function (event) {
    var button = $(event.relatedTarget);
    var modal = $(this);
    modal.find('#progress-id').val(button.data('id'));
    modal.find('#progress-season').val(button.data('season'));
    modal.find('#progress-episode').val(button.data('episode'));
  });
</script>
</body>
</html>